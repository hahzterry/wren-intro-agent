
{
  "name": "warehousejobz-ai",
  "version": "0.1.0",
  "private": true,
  "description": "WarehouseJobz AI: an SMS and iMessage recruiting assistant connecting warehouse workers with employers through double opt-in introductions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "node scripts/build-web.mjs",
    "gen:world": "node scripts/gen-world.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.7",
    "@types/node": "^22.0.0",
    "hono": "^4.13.18",
    "spectrum-ts": "^12.16.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
